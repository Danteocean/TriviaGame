# ==========================================
# SECCIÓN ANGULAR / FRONTEND (NUEVO)
# ==========================================
# Dependencias
node_modules/

# Salidas de compilación y caché de Angular
/dist/
/.angular/
/.cache/

# Cobertura de pruebas (Karma/Jest)
/coverage/

# Archivos de configuración de TypeScript
*.tsbuildinfo

# Logs de NPM/Yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# SECCIÓN .NET (TU CONFIGURACIÓN)
# ==========================================
bin/
obj/

# User-specific files
*.user
*.suo
*.cache
*.userosscache
*.sln.docstates

# Rider / VS / VSCode
.vs/
.idea/
.vscode/

###############
# LOGS
###############
*.log
logs/
Log/
log/

# Appsettings locales
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json

# KEEP MAIN appsettings.json (needed for config template)
!appsettings.json

# Ignore override files
docker-compose.override.yml
docker-compose.*.local.yml

###############
# DATABASE
###############

# Ignore dumps except the one needed to initialize DB
*.sql
!backup.sql

# Data directories from postgres local containers
pgdata/
postgres-data/
db-data/
docker-db/

