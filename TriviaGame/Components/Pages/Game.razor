@page "/game"
@using Microsoft.AspNetCore.WebUtilities
@using CoreLibrary.DTOs.GameSession.Requests
@using CoreLibrary.DTOs.GameSession.Response
@using CoreLibrary.Interface.Services.Client
@inject IGameSessionHttpClient GameClient
@inject IPlayerHttpClient PlayerService
@inject NavigationManager NavManager

<div class="game-page">
    <div class="game-card">
        <div class="game-header">
            <h1>Pregunta actual</h1>
        </div>

        @if (errorMessage != string.Empty)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (currentQuestion == null)
        {
            <p>Cargando pregunta...</p>
        }
        else
        {
            <div class="question-panel">
                <p class="question-text">@currentQuestion.Text</p>
            </div>

            <p>ID seleccionado: @selectedOptionId</p>

            <div class="options-grid">
                @foreach (var option in currentQuestion.Options)
                {
                    <button class="option-btn @(selectedOptionId == option.OptionId ? "selected" : "")"
                            @onclick="() => SelectOption(option.OptionId)">
                        @option.Text
                    </button>
                }
            </div>

            
            @if (selectedOptionId != -1)
            {
                <div class="confirm-panel" style="margin-top: 20px; padding: 15px; border: 1px solid #ccc;">
                    <p>¿Estás seguro de esta respuesta?</p>
                    <button class="btn-primary" @onclick="HandleConfirmSubmit" disabled="@isSubmitting">
                        @(isSubmitting ? "Enviando..." : "Confirmar respuesta")
                    </button>
                    <button class="btn-secondary" @onclick="ClearSelection">Cambiar</button>
                </div>
            }

            <div class="actions-row" style="margin-top: 20px;">
                <button class="btn-danger" @onclick="HandleWithdraw">Retirarse</button>
            </div>
        }
    </div>
</div>

@code {
    private Guid sessionId;
    private QuestionDtoResponse? currentQuestion;
    private int selectedOptionId = -1; // Inicializado en -1
    private bool isSubmitting;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var alias = QueryHelpers.ParseQuery(uri.Query).TryGetValue("alias", out var val) ? val.ToString() : string.Empty;

        var playerResp = await PlayerService.EnterGameAsync(alias);
        var sessionResp = await GameClient.StartGameAsync(playerResp.Data.Id);

        sessionId = sessionResp.Data;
        await LoadNextQuestionAsync();
    }

    private async Task LoadNextQuestionAsync()
    {
        var next = await GameClient.GetNextQuestionAsync(sessionId);
        if (next.Succeeded && next.Data != null)
        {
            currentQuestion = System.Text.Json.JsonSerializer.Deserialize<QuestionDtoResponse>(
                System.Text.Json.JsonSerializer.Serialize(next.Data)
            );
            selectedOptionId = -1;
            StateHasChanged();
        }
    }

    private void SelectOption(int optionId)
    {
        selectedOptionId = optionId;
        StateHasChanged(); 
    }

    private void ClearSelection()
    {
        selectedOptionId = -1;
        StateHasChanged();
    }

    private async Task HandleConfirmSubmit()
    {
        isSubmitting = true;
        var result = await GameClient.SubmitAnswerAsync(new AnswerDtoRequest { SessionId = sessionId, OptionId = selectedOptionId });

        if (result.Succeeded)
        {
            await LoadNextQuestionAsync();
        }
        else
        {
            NavManager.NavigateTo($"/result?sessionId={sessionId}&outcome=lose", true);
        }
        isSubmitting = false;
    }

    private async Task HandleWithdraw()
    {
        await GameClient.WithdrawAsync(sessionId);
        NavManager.NavigateTo($"/result?sessionId={sessionId}&outcome=retired", true);
    }
}