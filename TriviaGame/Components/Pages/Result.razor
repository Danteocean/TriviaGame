@page "/result"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using CoreLibrary.DTOs.GameSession.Response
@using Services.Http
@inject GameSessionHttpClient GameClient
@inject NavigationManager NavManager

<div class="result-page">
    <div class="result-card">
        @if (isLoading)
        {
            <div class="loading-panel">
                <div class="spinner"></div>
                <p>Cargando resultado...</p>
            </div>
        }
        else if (hasError)
        {
            <div class="result-message error">No se pudo cargar el resultado.</div>
            <p class="result-details">@errorMessage</p>
            <div class="result-actions">
                <button class="btn-primary" @onclick="GoHome">Volver al inicio</button>
            </div>
        }
        else
        {
            <div class="result-badge @resultClass">@resultTitle</div>
            <h1>@resultHeadline</h1>
            <p class="result-details">@resultDescription</p>

            <div class="stat-grid">
                <div>
                    <span class="stat-label">Puntaje acumulado</span>
                    <span class="stat-value">@displayScore</span>
                </div>
                <div>
                    <span class="stat-label">Ronda alcanzada</span>
                    <span class="stat-value">@displayRound</span>
                </div>
            </div>

            <div class="result-actions">
                <button class="btn-primary" @onclick="GoHome">Volver al Inicio</button>
                @if (outcome != "win")
                {
                    <button class="btn-secondary" @onclick="PlayAgain">Jugar de nuevo</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool hasError;
    private string errorMessage = string.Empty;
    private string outcome = string.Empty;
    private decimal displayScore;
    private int displayRound;
    private string resultTitle = string.Empty;
    private string resultHeadline = string.Empty;
    private string resultDescription = string.Empty;
    private string resultClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("sessionId", out var sessionIdValues) || !Guid.TryParse(sessionIdValues.ToString(), out var sessionId))
        {
            SetError("Parámetros de sesión inválidos.");
            return;
        }

        outcome = query.TryGetValue("outcome", out var outcomeValues) ? outcomeValues.ToString().ToLowerInvariant() : string.Empty;
        if (string.IsNullOrWhiteSpace(outcome))
        {
            SetError("No se recibió el resultado de la partida.");
            return;
        }

        var sessionResp = await GameClient.GetSessionByIdAsync(sessionId);
        if (!sessionResp.Succeeded || sessionResp.Data == null)
        {
            SetError(sessionResp.Message ?? "No se encontró la sesión.");
            return;
        }

        displayScore = sessionResp.Data.AccumulatedPrize;
        displayRound = sessionResp.Data.CurrentRound;

        if (outcome == "retired")
        {
            resultClass = "result-retired";
            resultTitle = "Te retiraste";
            resultHeadline = "¡Buen retiro!";
            resultDescription = "Te llevas el premio acumulado hasta ahora.";
        }
        else if (outcome == "lose")
        {
            resultClass = "result-lose";
            resultTitle = "Perdiste";
            resultHeadline = "Respuesta incorrecta";
            resultDescription = "No te preocupes, puedes intentarlo de nuevo.";
            displayScore = 0;
        }
        else
        {
            resultClass = "result-win";
            resultTitle = "¡Ganaste!";
            resultHeadline = "Triunfaste en el juego.";
            resultDescription = "Alcanzaste el final y ganaste el premio mayor.";
        }

        isLoading = false;
    }

    private void SetError(string message)
    {
        hasError = true;
        errorMessage = message;
        isLoading = false;
    }

    private void GoHome()
    {
        NavManager.NavigateTo("/");
    }

    private void PlayAgain()
    {
        NavManager.NavigateTo("/");
    }
}
