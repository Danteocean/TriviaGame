@page "/result"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using CoreLibrary.DTOs.GameSession.Response
@using Services.Http
@inject GameSessionHttpClient GameClient
@inject NavigationManager NavManager

<div class="result-page">
    <div class="result-card">
        @if (isLoading)
        {
            <div class="loading-panel">
                <div class="spinner"></div>
                <p>Cargando resultado...</p>
            </div>
        }
        else if (hasError)
        {
            <div class="result-message error">No se pudo cargar el resultado.</div>
            <p class="result-details">@errorMessage</p>
            <div class="result-actions">
                <button class="btn-primary" @onclick="GoHome">Volver al inicio</button>
            </div>
        }
        else
        {
            @if (outcome == "win")
            {
                <div class="confetti-wrap">
                    @for (int i = 0; i < 60; i++)
                    {
                        var style = $"left:{RandomPercent()}%;" +
                                    $"background:{RandomColor()};" +
                                    $"animation-delay:{RandomDelay()}s;" +
                                    $"animation-duration:{RandomDuration()}s;" +
                                    $"width:{RandomSize()}px;height:{RandomSize()}px;";
                        <div class="confetti-piece" style="@style"></div>
                    }
                </div>
                <div class="end-icon">🏆</div>
                <h2 class="end-title won">¡GANASTE!</h2>
                <p class="end-subtitle">Respondiste las @displayRound rondas correctamente</p>
                <div class="end-prize won">@FormatPrize(displayScore)</div>
            }
            else if (outcome == "lose")
            {
                <div class="end-icon">💥</div>
                <h2 class="end-title elim">ELIMINADO</h2>
                <p class="end-subtitle">Respuesta incorrecta — pierdes todo el acumulado</p>
                <div class="end-prize elim">$0</div>
            }
            else
            {
                <div class="end-icon">🚪</div>
                <h2 class="end-title retired">RETIRADO</h2>
                <p class="end-subtitle">Decidiste retirarte antes de responder</p>
                <div class="end-prize ret">@FormatPrize(displayScore)</div>
            }

            <div class="result-stat">
                <span class="result-stat-label">Ronda alcanzada</span>
                <span class="result-stat-value">@displayRound de 5</span>
            </div>

            <div class="result-actions">
                <button class="btn-primary" @onclick="GoHome">Volver al Inicio</button>
                @if (outcome != "win")
                {
                    <button class="btn-secondary" @onclick="PlayAgain">Jugar de nuevo</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool hasError;
    private string errorMessage = string.Empty;
    private string outcome = string.Empty;
    private decimal displayScore;
    private int displayRound;

    private static readonly Random _rng = new();

    protected override async Task OnInitializedAsync()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("sessionId", out var sessionIdValues) || !Guid.TryParse(sessionIdValues.ToString(), out var sessionId))
        {
            SetError("Parámetros de sesión inválidos.");
            return;
        }

        outcome = query.TryGetValue("outcome", out var outcomeValues) ? outcomeValues.ToString().ToLowerInvariant() : string.Empty;
        if (string.IsNullOrWhiteSpace(outcome))
        {
            SetError("No se recibió el resultado de la partida.");
            return;
        }

        displayRound = query.TryGetValue("rounds", out var roundVal) && int.TryParse(roundVal.ToString(), out var r) ? r : 1;

        var sessionResp = await GameClient.GetSessionByIdAsync(sessionId);
        if (!sessionResp.Succeeded || sessionResp.Data == null)
        {
            SetError(sessionResp.Message ?? "No se encontró la sesión.");
            return;
        }

        displayScore = outcome == "lose" ? 0 : sessionResp.Data.AccumulatedPrize;
        if (displayRound == 1) displayRound = sessionResp.Data.CurrentRound;

        isLoading = false;
    }

    private void SetError(string message)
    {
        hasError = true;
        errorMessage = message;
        isLoading = false;
    }

    private void GoHome()
    {
        NavManager.NavigateTo("/");
    }

    private void PlayAgain()
    {
        NavManager.NavigateTo("/");
    }

    private static string FormatPrize(decimal amount)
    {
        return $"${amount:N0}";
    }

    private static string RandomPercent() => $"{_rng.Next(0, 101)}";
    private static string RandomDelay() => $"{_rng.NextDouble() * 2:F1}";
    private static string RandomDuration() => $"{2 + _rng.NextDouble() * 2:F1}";
    private static string RandomSize() => $"{6 + _rng.Next(10)}";
    private static string RandomColor()
    {
        var colors = new[] { "#fbbf24", "#22c55e", "#60a5fa", "#f97316", "#a78bfa", "#ffffff" };
        return colors[_rng.Next(colors.Length)];
    }
}
